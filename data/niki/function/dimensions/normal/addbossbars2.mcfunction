$bossbar add $(name)/r "Červený"
$bossbar add $(name)/b "Modrý"
$bossbar add $(name)/y "Žltý"
$bossbar add $(name)/g "Zelený"

$bossbar set $(name)/r color red
$bossbar set $(name)/b color blue
$bossbar set $(name)/y color yellow
$bossbar set $(name)/g color green

$bossbar set $(name)/r style notched_10
$bossbar set $(name)/b style notched_10
$bossbar set $(name)/y style notched_10
$bossbar set $(name)/g style notched_10
